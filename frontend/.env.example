# Local SQLite file (relative to the frontend/ dir). Swap this for a Postgres/MySQL
# URL later without touching n8n — see docs/AI-Lead-Flow-Architecture.md §6.
DATABASE_URL=data.sqlite

# Shared secret n8n sends as the `x-api-key` header on every DB API call.
# Leave unset for local dev (auth is skipped). Set it before exposing the app.
# LEAD_API_KEY=change-me
